# =============================================================================
# Tyfel Hub (F&B Operations Cockpit) — Production Environment Variables
# Copy this file to .env.local and configure your credentials.
# =============================================================================

# ─── Authentication (REQUIRED) ───────────────────────────────────────────────
# JWT signing secret — min 32 characters. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET="CHANGE_ME_GENERATE_A_REAL_SECRET_MIN_32_CHARS"

# First-run admin user seeding (dev only — ignored once user exists in database)
SEED_ADMIN_EMAIL="admin@tyfel.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_USE_A_STRONG_PASSWORD"
SEED_ADMIN_NAME="Operations Admin"

# ─── Supabase / PostgreSQL Database (REQUIRED) ───────────────────────────────
# Connection pooler URL (Port 6543, Transaction mode for Serverless Next.js queries)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Direct / Session URL (Port 5432, for Drizzle schema push: npm run db:push)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Storage & Raw Reports (Optional) ────────────────────────────────────────
# Path to raw POS / aggregator CSV data lake
RAW_REPORTS_DIR="./data/raw"
