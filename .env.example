# =============================================================================
# F&B Operations Cockpit — Environment Variables (.env.example)
# Copy this file to .env.local and fill in your credentials.
# =============================================================================

# ─── Authentication (REQUIRED) ───────────────────────────────────────────────
# JWT signing secret — min 32 characters. Generate with: openssl rand -base64 48
AUTH_JWT_SECRET="CHANGE_ME_GENERATE_A_REAL_SECRET"

# First-run admin seeding (dev only — ignored in production)
SEED_ADMIN_EMAIL="admin@mausatelier.id"
SEED_ADMIN_PASSWORD="CHANGE_ME_USE_A_STRONG_PASSWORD"
SEED_ADMIN_NAME="Admin"

# Legacy staff passcode auth (comma-separated list, optional)
# STAFF_PASSCODES="secretcode1,secretcode2"

# ─── Supabase PostgreSQL Database (Primary Production & Development) ─────────
# Connection pooler URL (Port 6543, Transaction mode for Serverless Next.js queries)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Direct / Session URL (Port 5432, for Drizzle migrations: npx drizzle-kit push)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Layerbase Database (Legacy / Fallback) ──────────────────────────────────
# Layerbase Serverless SQL HTTP Endpoint (No 10 KB query limit)
LAYERBASE_SQL_ENDPOINT="https://api.sage.cloud.layerbase.dev/sql"
LAYERBASE_CONNECTION_STRING="postgresql://user:password@pooler-host.sage.cloud.layerbase.dev/db_name?sslmode=require"

# Layerbase Management Query API (Fallback / Push Script)
LAYERBASE_QUERY_URL="https://your-instance.sage.cloud.layerbase.dev/v1/databases/your-db-id/query"
LAYERBASE_API_KEY="sk_your_layerbase_api_key"

# Set to "true" to force local DuckDB file mode (data/fnb_analytics.duckdb) instead of Layerbase HTTP
# LAYERBASE_DISABLED="false"

# Optional custom paths for local DuckDB and CSV data lake
# DUCKDB_PATH="./data/fnb_analytics.duckdb"
# RAW_REPORTS_DIR="./data/raw"

